# Copy this file to .env and fill in real values. .env is gitignored so
# secrets never get committed.

# --- email_poc.cli / email_poc.gemini_classifier (Vertex AI / Gemini via ADC) ---
GOOGLE_CLOUD_PROJECT=bert-vs-llm-poc
GOOGLE_CLOUD_LOCATION=europe-west2

# --- email_poc.model_downloader (internal Artifactory mirror for HuggingFace models) ---
HF_ENDPOINT=https://infyartifactory.jfrog.io/artifactory/api/huggingfaceml/huggingface-remote
HF_TOKEN=

# Optional: path to a corporate CA bundle if requests fail TLS verification
# behind a proxy (e.g. Zscaler). Leave blank if not needed.
REQUESTS_CA_BUNDLE=
